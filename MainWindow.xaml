<Window x:Class="Vellum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Vellum.ViewModels"
        mc:Ignorable="d"
        Title="Vellum — Текстовый редактор"
        Height="720" Width="1200"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Анимация появления -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Главный Border с тенью и скруглёнными углами -->
    <Border CornerRadius="8"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Заголовок -->
                <RowDefinition Height="36"/>
                <!-- Меню -->
                <RowDefinition Height="Auto"/>
                <!-- Панель инструментов -->
                <RowDefinition Height="Auto"/>
                <!-- Контент (вкладки + редактор) -->
                <RowDefinition Height="*"/>
                <!-- Панель поиска -->
                <RowDefinition Height="Auto"/>
                <!-- Статус-бар -->
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- ===== ЗАГОЛОВОК ОКНА ===== -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                  MouseMove="TitleBar_MouseMove">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип и название -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <!-- Иконка логотипа (SVG path) -->
                    <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3,3 L21,3 L21,21 L3,21 Z M7,7 L7,17 L17,17 L17,7 Z M10,10 L10,14 L14,14 L14,10 Z"
                                  Fill="{DynamicResource AccentBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Vellum" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource ForegroundBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Центр заголовка -->
                <TextBlock Grid.Column="1"
                           Text="Vellum — Текстовый редактор"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundDarkerBrush}"
                           FontSize="11"/>

                <!-- Кнопки управления окном -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Content="─" Width="46" Height="36"
                            Click="BtnMinimize_Click"
                            Style="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" Padding="0">
                                    <TextBlock Text="─" FontSize="12"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnMaximize" Content="□" Width="46" Height="36"
                            Click="BtnMaximize_Click"
                            Style="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" Padding="0">
                                    <TextBlock x:Name="icon" Text="□" FontSize="12"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnClose" Content="✕" Width="46" Height="36"
                            Click="BtnClose_Click"
                            Style="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" Padding="0">
                                    <TextBlock Text="✕" FontSize="12"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{StaticResource ErrorBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== МЕНЮ ===== -->
            <Menu Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}"
                  Foreground="{DynamicResource ForegroundBrush}"
                  BorderThickness="0,0,0,1"
                  BorderBrush="{DynamicResource BorderBrush}">
                <MenuItem Header="_Файл">
                    <MenuItem Header="_Новый" InputGestureText="Ctrl+N"
                              Command="{Binding NewFileCommand}"/>
                    <MenuItem Header="_Открыть..." InputGestureText="Ctrl+O"
                              Command="{Binding OpenFileCommand}"/>
                    <Separator/>
                    <MenuItem Header="_Сохранить" InputGestureText="Ctrl+S"
                              Command="{Binding SaveFileCommand}"/>
                    <MenuItem Header="Сохранить _как..." InputGestureText="Ctrl+Shift+S"
                              Command="{Binding SaveFileAsCommand}"/>
                    <Separator/>
                    <MenuItem Header="Закрыть _вкладку" InputGestureText="Ctrl+W"
                              Command="{Binding CloseActiveDocumentCommand}"/>
                    <Separator/>
                    <MenuItem Header="Выход" Click="MenuExit_Click"/>
                </MenuItem>

                <MenuItem Header="_Правка">
                    <MenuItem Header="_Отменить" InputGestureText="Ctrl+Z"
                              Click="MenuUndo_Click"/>
                    <MenuItem Header="_Повторить" InputGestureText="Ctrl+Y"
                              Click="MenuRedo_Click"/>
                    <Separator/>
                    <MenuItem Header="Вы_резать" InputGestureText="Ctrl+X"
                              Click="MenuCut_Click"/>
                    <MenuItem Header="_Копировать" InputGestureText="Ctrl+C"
                              Click="MenuCopy_Click"/>
                    <MenuItem Header="Вст_авить" InputGestureText="Ctrl+V"
                              Click="MenuPaste_Click"/>
                    <MenuItem Header="_Выделить всё" InputGestureText="Ctrl+A"
                              Click="MenuSelectAll_Click"/>
                    <Separator/>
                    <MenuItem Header="_Поиск..." InputGestureText="Ctrl+F"
                              Command="{Binding ToggleSearchCommand}"/>
                    <MenuItem Header="_Замена..." InputGestureText="Ctrl+H"
                              Click="MenuReplace_Click"/>
                    <MenuItem Header="_Перейти к строке..." InputGestureText="Ctrl+G"
                              Click="MenuGoToLine_Click"/>
                </MenuItem>

                <MenuItem Header="_Вид">
                    <MenuItem Header="С_ледующая вкладка" InputGestureText="Ctrl+Tab"
                              Command="{Binding SwitchToNextDocumentCommand}"/>
                    <MenuItem Header="_Предыдущая вкладка" InputGestureText="Ctrl+Shift+Tab"
                              Command="{Binding SwitchToPreviousDocumentCommand}"/>
                    <Separator/>
                    <MenuItem Header="Н_омера строк" IsCheckable="True" IsChecked="True"
                              Click="MenuLineNumbers_Click"/>
                    <MenuItem Header="С_вёртывание кода" IsCheckable="True" IsChecked="True"
                              Click="MenuCodeFolding_Click"/>
                </MenuItem>

                <MenuItem Header="_Тема">
                    <MenuItem Header="Т_ёмная" Click="MenuDarkTheme_Click"/>
                    <MenuItem Header="_Светлая" Click="MenuLightTheme_Click"/>
                </MenuItem>

                <MenuItem Header="С_правка">
                    <MenuItem Header="О _программе" Click="MenuAbout_Click"/>
                </MenuItem>
            </Menu>

            <!-- ===== ПАНЕЛЬ ИНСТРУМЕНТОВ ===== -->
            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Padding="4,2">
                <WrapPanel Orientation="Horizontal">
                    <Button ToolTip="Новый (Ctrl+N)" Command="{Binding NewFileCommand}" Padding="6,4"
                            Style="{x:Null}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M8,1 L8,15 M1,8 L15,8" Stroke="{DynamicResource ForegroundBrush}"
                                      StrokeThickness="2"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button ToolTip="Открыть (Ctrl+O)" Command="{Binding OpenFileCommand}" Padding="6,4"
                            Style="{x:Null}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M2,14 L2,5 L7,5 L8,4 L14,4 L14,14 Z"
                                      Stroke="{DynamicResource ForegroundBrush}"
                                      StrokeThickness="1.5" Fill="Transparent"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button ToolTip="Сохранить (Ctrl+S)" Command="{Binding SaveFileCommand}" Padding="6,4"
                            Style="{x:Null}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M12,2 L12,14 L4,14 L4,2 Z M7,2 L7,5 L10,5 L10,2 M5,9 L11,9"
                                      Stroke="{DynamicResource ForegroundBrush}"
                                      StrokeThickness="1.5" Fill="Transparent"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="4,0"/>

                    <Button ToolTip="Отменить (Ctrl+Z)" Click="MenuUndo_Click" Padding="6,4"
                            Style="{x:Null}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M4,7 L7,4 M4,7 L7,10 M4,7 L12,7 C13.7,7 14,8 14,9 L14,9"
                                      Stroke="{DynamicResource ForegroundBrush}"
                                      StrokeThickness="1.5" Fill="Transparent"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button ToolTip="Повторить (Ctrl+Y)" Click="MenuRedo_Click" Padding="6,4"
                            Style="{x:Null}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M12,7 L9,4 M12,7 L9,10 M12,7 L4,4 C2.3,4 2,5 2,6 L2,6"
                                      Stroke="{DynamicResource ForegroundBrush}"
                                      StrokeThickness="1.5" Fill="Transparent"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="4,0"/>

                    <Button ToolTip="Поиск (Ctrl+F)" Command="{Binding ToggleSearchCommand}" Padding="6,4"
                            Style="{x:Null}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="9" Height="9"
                                         Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.5"/>
                                <Line X1="8" Y1="8" X2="13" Y2="13"
                                      Stroke="{DynamicResource ForegroundBrush}" StrokeThickness="1.5"
                                     />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button ToolTip="Замена (Ctrl+H)" Click="MenuReplace_Click" Padding="6,4"
                            Style="{x:Null}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M3,3 L13,3 L13,8 L8,8 L6,10 L6,8 L3,8 Z"
                                      Stroke="{DynamicResource ForegroundBrush}"
                                      StrokeThickness="1.2" Fill="Transparent"
                                      StrokeLineJoin="Round"/>
                                <Path Data="M4,12 L8,12 M4,12 L4,10 M8,12 L8,10"
                                      Stroke="{DynamicResource ForegroundBrush}"
                                      StrokeThickness="1.5"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button ToolTip="Перейти к строке (Ctrl+G)" Click="MenuGoToLine_Click" Padding="6,4"
                            Style="{x:Null}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <TextBlock Text="G" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource ForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" Margin="4,0"/>

                    <Button ToolTip="Командная палитра (Ctrl+Shift+P)"
                            Command="{Binding ToggleCommandPaletteCommand}" Padding="6,4"
                            Style="{x:Null}">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Data="M8,1 L8,15 M1,8 L15,8"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="2"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </WrapPanel>
            </Border>

            <!-- ===== КОНТЕНТ: ВКЛАДКИ + РЕДАКТОР ===== -->
            <Grid Grid.Row="3">
                <TabControl x:Name="DocumentTabs"
                            ItemsSource="{Binding Documents}"
                            SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0">

                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayTitle}"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                           MaxWidth="200" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="✕" FontSize="10"
                                           Cursor="Hand" Foreground="{DynamicResource ForegroundDarkerBrush}"
                                           MouseLeftButtonDown="TabClose_Click"
                                           Tag="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>

                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid>
                                <avalonedit:TextEditor x:Name="Editor"
                                    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
                                    Document="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SyntaxHighlighting="{Binding SyntaxHighlighting}"
                                    FontFamily="{Binding DataContext.SettingsViewModel.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                    FontSize="{Binding DataContext.SettingsViewModel.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ShowLineNumbers="{Binding DataContext.SettingsViewModel.ShowLineNumbers, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Background="{DynamicResource EditorBackgroundBrush}"
                                    Foreground="{DynamicResource EditorForegroundBrush}"
                                    BorderThickness="0"
                                    Padding="4,4"
                                    WordWrap="True"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto"
                                    AllowDrop="True"
                                    GotFocus="Editor_GotFocus"
                                    TextChanged="Editor_TextChanged">

                                    <!-- Контекстное меню -->
                                    <avalonedit:TextEditor.ContextMenu>
                                        <ContextMenu Background="{DynamicResource PanelBackgroundBrush}"
                                                     Foreground="{DynamicResource ForegroundBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}">
                                            <MenuItem Header="Отменить" Click="MenuUndo_Click"
                                                      InputGestureText="Ctrl+Z"/>
                                            <MenuItem Header="Повторить" Click="MenuRedo_Click"
                                                      InputGestureText="Ctrl+Y"/>
                                            <Separator/>
                                            <MenuItem Header="Вырезать" Click="MenuCut_Click"
                                                      InputGestureText="Ctrl+X"/>
                                            <MenuItem Header="Копировать" Click="MenuCopy_Click"
                                                      InputGestureText="Ctrl+C"/>
                                            <MenuItem Header="Вставить" Click="MenuPaste_Click"
                                                      InputGestureText="Ctrl+V"/>
                                            <MenuItem Header="Выделить всё" Click="MenuSelectAll_Click"
                                                      InputGestureText="Ctrl+A"/>
                                            <Separator/>
                                            <MenuItem Header="Поиск..." Click="SearchFromContext_Click"
                                                      InputGestureText="Ctrl+F"/>
                                        </ContextMenu>
                                    </avalonedit:TextEditor.ContextMenu>
                                </avalonedit:TextEditor>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <!-- Пустой стейт, когда нет открытых вкладок -->
                <StackPanel x:Name="EmptyStatePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding Documents.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <Viewbox Width="64" Height="64" Margin="0,0,0,16">
                        <Canvas Width="64" Height="64">
                            <Path Data="M12,4 L40,4 L52,16 L52,56 L12,56 Z M16,8 L38,8 L38,16 L16,16 Z"
                                  Stroke="{DynamicResource ForegroundDarkerBrush}"
                                  StrokeThickness="2" Fill="Transparent"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Нет открытых документов"
                               Foreground="{DynamicResource ForegroundDarkerBrush}"
                               FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ctrl+N — новый файл  |  Ctrl+O — открыть файл"
                               Foreground="{DynamicResource ForegroundDarkerBrush}"
                               FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ===== ПАНЕЛЬ ПОИСКА ===== -->
            <Border x:Name="SearchPanel"
                    Grid.Row="4"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Padding="12,8"
                    Visibility="{Binding IsSearchPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <!-- Строка поиска -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Поиск:" Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center" Width="60"/>
                            <TextBox x:Name="SearchTextBox" Width="300"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center"
                                     Background="{DynamicResource PanelDarkerBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     CaretBrush="{DynamicResource ForegroundBrush}"/>
                            <CheckBox Content="Aa" ToolTip="Учитывать регистр"
                                      IsChecked="{Binding MatchCase}"
                                      Foreground="{DynamicResource ForegroundBrush}"
                                      Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <CheckBox Content=".*" ToolTip="Регулярные выражения"
                                      IsChecked="{Binding UseRegex}"
                                      Foreground="{DynamicResource ForegroundBrush}"
                                      Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <CheckBox Content="АС" ToolTip="Целые слова"
                                      IsChecked="{Binding WholeWord}"
                                      Foreground="{DynamicResource ForegroundBrush}"
                                      Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Строка замены -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsReplaceMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Замена:" Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center" Width="60"/>
                            <TextBox Width="300"
                                     Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center"
                                     Background="{DynamicResource PanelDarkerBrush}"
                                     Foreground="{DynamicResource ForegroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     CaretBrush="{DynamicResource ForegroundBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Кнопки -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Найти ▲" Command="{Binding FindPreviousCommand}"
                                Margin="4,0" Padding="8,4"
                                Style="{x:Null}"
                                Background="{DynamicResource PanelLighterBrush}"
                                Foreground="{DynamicResource ForegroundBrush}"/>
                        <Button Content="Найти ▼" Command="{Binding FindNextCommand}"
                                Margin="4,0" Padding="8,4"
                                Style="{x:Null}"
                                Background="{DynamicResource PanelLighterBrush}"
                                Foreground="{DynamicResource ForegroundBrush}"/>
                        <Button Content="Заменить" Command="{Binding ReplaceCurrentCommand}"
                                Margin="4,0" Padding="8,4"
                                Visibility="{Binding IsReplaceMode, Converter={StaticResource BoolToVisibility}}"
                                Style="{x:Null}"
                                Background="{DynamicResource PanelLighterBrush}"
                                Foreground="{DynamicResource ForegroundBrush}"/>
                        <Button Content="Заменить все" Command="{Binding ReplaceAllCommand}"
                                Margin="4,0" Padding="8,4"
                                Visibility="{Binding IsReplaceMode, Converter={StaticResource BoolToVisibility}}"
                                Style="{x:Null}"
                                Background="{DynamicResource PanelLighterBrush}"
                                Foreground="{DynamicResource ForegroundBrush}"/>
                        <Button Content="✕" Click="CloseSearchPanel_Click"
                                Margin="4,0" Padding="8,4"
                                Style="{x:Null}"
                                Background="{DynamicResource PanelLighterBrush}"
                                Foreground="{DynamicResource ForegroundBrush}"
                                ToolTip="Закрыть (Esc)"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== СТАТУС-БАР ===== -->
            <Border Grid.Row="5"
                    Background="{DynamicResource StatusBarBackgroundBrush}"
                    Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusBarText}"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontSize="11"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   FontSize="11" Margin="0,0,12,0"/>
                        <TextBlock Text="Vellum v1.0"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   FontSize="11" Opacity="0.7"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== КОМАНДНАЯ ПАЛИТРА (оверлей) ===== -->
            <Border x:Name="CommandPaletteOverlay"
                    Grid.Row="0" Grid.RowSpan="6"
                    Background="#80000000"
                    Visibility="{Binding IsCommandPaletteVisible, Converter={StaticResource BoolToVisibility}}"
                    MouseLeftButtonDown="Overlay_Click">
                <Border x:Name="CommandPaletteBox"
                        Width="500" MaxHeight="400"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,60"
                        MouseLeftButtonDown="CommandPalette_MouseLeftButtonDown">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0"
                                 Text="{Binding CommandPaletteFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="12" Padding="8,8"
                                 FontSize="14"
                                 Background="{DynamicResource PanelDarkerBrush}"
                                 Foreground="{DynamicResource ForegroundBrush}"
                                 BorderBrush="{DynamicResource AccentBrush}"
                                 BorderThickness="1,1,1,1"
                                 CaretBrush="{DynamicResource ForegroundBrush}"
                                 Tag="Введите команду..."/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding FilteredCommands}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="0,0,0,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8" Cursor="Hand"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                       FontSize="13"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Shortcut}"
                                                       Foreground="{DynamicResource ForegroundDarkerBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>
            </Border>

        </Grid>
    </Border>
</Window>
